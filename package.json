{
  "name": "ctj",
  "version": "0.1.0",
  "description": "CTJ: C++ transpiler to JavaScript written in TypeScript",
  "scripts": {
    "build": "node scripts/build.js",
    "build:core": "node scripts/build.js --without shapes",
    "serve": "node scripts/serve.js",
    "test": "node test/run.js && node test/shape.js",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.js\" \"test/*.js\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.js\" \"test/*.js\""
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "typescript": "^5.4.0"
  }
}
