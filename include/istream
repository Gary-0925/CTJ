// <istream> for CTJ.  Input is not supported: the class exists so that the
// headers which name it (<iostream>, <sstream>, <fstream>) still parse.
#ifndef _CTJ_ISTREAM
#define _CTJ_ISTREAM 1

#include <ios>

namespace std {

  template<typename _CharT, typename _Traits = char_traits<_CharT> >
    class basic_istream : public ios_base
    {
    public:
      typedef _CharT char_type;
      typedef _Traits traits_type;

      explicit basic_istream(int __fd = 0) : ios_base() { }
    };

  typedef basic_istream<char> istream;

}

#endif /* _CTJ_ISTREAM */
