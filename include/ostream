  // "cout << endl" is an ordinary call of operator<< with no overload on a
  // function pointer.
  class _Ios_op {
  public:
    int _M_kind;
    _Ios_op(int __k) : _M_kind(__k) { }
  };

  const _Ios_op endl(0);
  const _Ios_op ends(1);
  const _Ios_op flush(2);

  inline ostream& operator<<(ostream& __os, const _Ios_op& __m)
  {
    if (__m._M_kind == 0) __os._M_put(8, 10, 0, 0);
    else if (__m._M_kind == 1) __os._M_put(8, 0, 0, 0);
    else __os._M_put(9, 0, 0, 0);
    return __os;
  }

