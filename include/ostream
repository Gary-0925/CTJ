namespace std {

  template<typename _CharT, typename _Traits = char_traits<_CharT> >
    class basic_ostream : public ios_base
    {
    public:
      typedef _CharT char_type;
      typedef _Traits traits_type;
      typedef basic_ostream<_CharT, _Traits> __ostream_type;

      // File descriptor the stream writes to: 1 for stdout, 2 for stderr.
      int _M_fd;

      explicit basic_ostream(int __fd = 1) : ios_base(), _M_fd(__fd) { }

      // The one place where characters leave the program.  The fields of the
      // stream are passed along; the width applies to this output only.
      void _M_put(int __k, double __v, const _CharT* __s, long __n)
      {
        __ctj_js(_CTJ_OUT_JS, __k, __v, __s, __n, this->_M_flags, this->_M_width,
                 this->_M_precision, this->_M_fill, this->_M_fd);
        __ctj_php(_CTJ_OUT_PHP, __k, __v, __s, __n, this->_M_flags, this->_M_width,
                  this->_M_precision, this->_M_fill, this->_M_fd);
        this->_M_width = 0;
      }

      __ostream_type& put(_CharT __c) { _M_put(8, __c, 0, 0); return *this; }
      __ostream_type& write(const _CharT* __s, long __n) { _M_put(10, 0, __s, __n); return *this; }
      __ostream_type& flush() { _M_put(9, 0, 0, 0); return *this; }
    };

  typedef basic_ostream<char> ostream;

  // The formatted output operators are free functions, not members: the
  // transpiler resolves a call of a free function to one overload at compile
  // time, while the overloads of a member are told apart at run time, and
  // int and char are both numbers there.

  inline ostream& operator<<(ostream& __os, bool __n) { __os._M_put(6, __n ? 1 : 0, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, short __n) { __os._M_put(0, __n, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, unsigned short __n) { __os._M_put(1, __n, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, int __n) { __os._M_put(0, __n, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, unsigned int __n) { __os._M_put(1, __n, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, long __n) { __os._M_put(3, __n, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, unsigned long __n) { __os._M_put(2, __n, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, long long __n) { __os._M_put(3, __n, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, unsigned long long __n) { __os._M_put(2, __n, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, float __n) { __os._M_put(4, __n, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, double __n) { __os._M_put(4, __n, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, long double __n) { __os._M_put(4, __n, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, char __c) { __os._M_put(5, __c, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, signed char __c) { __os._M_put(5, __c, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, unsigned char __c) { __os._M_put(5, __c, 0, 0); return __os; }
  inline ostream& operator<<(ostream& __os, const char* __s) { __os._M_put(7, 0, __s, -1); return __os; }

  inline ostream& operator<<(ostream& __os, const _Ios_fmt& __m)
  {
    __os._M_flags = (__os._M_flags & ~__m._M_mask) | __m._M_value;
