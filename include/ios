// <ios> for CTJ: the format manipulators of the stream classes.  See
// <bits/ios_base.h> for why this is not the libstdc++ header.
#ifndef _CTJ_IOS
#define _CTJ_IOS 1

#include <bits/char_traits.h>
#include <bits/ios_base.h>
#include <bits/basic_ios.h>

namespace std {

  const _Ios_fmt boolalpha(0x01, 0x01);
  const _Ios_fmt noboolalpha(0x01, 0x00);
  const _Ios_fmt dec(0x4a, 0x02);
  const _Ios_fmt hex(0x4a, 0x08);
  const _Ios_fmt oct(0x4a, 0x40);
  const _Ios_fmt left(0xb0, 0x20);
  const _Ios_fmt right(0xb0, 0x80);

}

#endif /* _CTJ_IOS */
