// <iomanip> for CTJ: the manipulators which take an argument.
#ifndef _CTJ_IOMANIP
#define _CTJ_IOMANIP 1

#include <ios>

namespace std {

  inline _Ios_arg setw(int __n) { return _Ios_arg(1, __n); }
  inline _Ios_arg setprecision(int __n) { return _Ios_arg(2, __n); }
  inline _Ios_arg setfill(char __c) { return _Ios_arg(3, __c); }
  inline _Ios_fmt setiosflags(int __m) { return _Ios_fmt(__m, __m); }
  inline _Ios_fmt resetiosflags(int __m) { return _Ios_fmt(__m, 0); }
  inline _Ios_fmt setbase(int __b)
  {
    return _Ios_fmt(0x4a, __b == 16 ? 0x08 : (__b == 8 ? 0x40 : (__b == 10 ? 0x02 : 0x4a)));
  }

}

#endif /* _CTJ_IOMANIP */
