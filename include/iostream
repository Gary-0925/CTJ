// <iostream> for CTJ: the standard stream objects.  The objects are defined
// here, not in a library: the transpiler compiles the whole program itself.
#ifndef _CTJ_IOSTREAM
#define _CTJ_IOSTREAM 1

#include <ostream>
#include <istream>

namespace std {

  ostream cout(1);
  ostream cerr(2);
  ostream clog(3);
  istream cin(0);

}

#endif /* _CTJ_IOSTREAM */
